 // runOne 执行一条已认领的任务（含全部失败路径的收尾）；hostLoad 计数由调用方释放。
 func runOne(ctx context.Context, c cfg, worker string, id int64) {
+	// Keep the worker lease until in-flight pages and completion events have drained.
+	// PHP must not requeue a stopped task while this lease is still held.
+	defer func() {
+		releaseCtx, releaseCancel := context.WithTimeout(context.Background(), 8*time.Second)
+		defer releaseCancel()
+		db.ExecContext(releaseCtx, "UPDATE rsync_tasks SET worker='' WHERE id=? AND worker=? AND status<>'running'", id, worker)
+	}()
 	defer func() {
 		if r := recover(); r != nil { // 单任务 panic 只判该任务失败，不退休 worker goroutine
 			log.Printf("worker %s 任务 %d panic: %v", worker, id, r)
@@ -1189,6 +1196,10 @@
