 	db = initDB(c)
 	defer db.Close()
+	// A previous process cannot still own terminal jobs after this service restarts.
+	if _, err := db.Exec("UPDATE rsync_tasks SET worker='' WHERE status NOT IN ('pending','running')"); err != nil {
+		log.Fatalf("release terminal task leases: %v", err)
